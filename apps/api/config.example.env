# Example environment variables for local development
# Copy to .env and customize before running

# Application
APP_ENV=development
APP_PORT=:6060
LOG_LEVEL=info

# Postgres
POSTGRES_USER=tracker
POSTGRES_PASSWORD=example
POSTGRES_DB=ta11y
# Optional full DB url (used by some libraries)
DATABASE_URL=postgres://admin:Postgres2026%21@localhost:5432/ta11y?sslmode=disable

# Elasticsearch
ELASTICSEARCH_HOST=http://elasticsearch:9200
ES_JAVA_OPTS=-Xms1g -Xmx1g

# APM
APM_SERVER_URL=http://apm-server:8200
APM_AUTH_ANON=true

# Authentication (OIDC). Credentials are per provider slug: <SLUG>_CLIENT_ID / _SECRET.
# Set auth.enabled: true in config.yaml to switch sign-in on.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
# Claims the seeded account on first sign-in so existing data is not orphaned.
AUTH_BOOTSTRAP_ADMIN_EMAIL=

# API Keys
ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_API_KEY_HERE
MARKETSTACK_API_KEY=YOUR_MARKETSTACK_API_KEY_HERE
